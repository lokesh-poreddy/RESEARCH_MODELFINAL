{
  "$id": "evidence.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "type": "object",
  "required": ["id", "schema_version", "source"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "source": { "type": "string" },
    "source_id": { "type": ["string", "null"] },
    "retrieval_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "retriever": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "text_location": { "type": ["string", "null"] },
    "quality_indicators": { "type": ["object", "null"] },
    "claim_relationship": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"] },
    "snippet": { "type": ["string", "null"] },
    "metadata": { "type": ["object", "null"] },
    "evidence_type": { "type": ["string", "null"] },
    "source_type": { "type": ["string", "null"] },
    "claim_id": { "type": ["string", "null"] },
    "relation": { "type": ["string", "null"] },
    "provenance_id": { "type": ["string", "null"] },
    "quality": { "type": ["object", "null"] },
    "originating_vrdeg_node_ids": { "type": ["array", "null"], "items": { "type": "string" } },
    "originating_experiment_ids": { "type": ["array", "null"], "items": { "type": "string" } },
    "originating_run_ids": { "type": ["array", "null"], "items": { "type": "string" } },
    "originating_outcome_ids": { "type": ["array", "null"], "items": { "type": "string" } },
    "originating_trajectory_ids": { "type": ["array", "null"], "items": { "type": "string" } },
    "created_at": { "type": ["number", "null"] }
  },
  "additionalProperties": false
}

